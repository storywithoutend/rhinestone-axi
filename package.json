{
  "name": "rhinestone-axi",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Forensic diagnostics for captured Rhinestone intent failures",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storywithoutend/rhinestone-axi.git"
  },
  "homepage": "https://github.com/storywithoutend/rhinestone-axi#readme",
  "bugs": {
    "url": "https://github.com/storywithoutend/rhinestone-axi/issues"
  },
  "bin": {
    "ens-rhinestone": "dist/bin.js",
    "rhinestone-axi": "dist/bin.js"
  },
  "files": [
    "AXI.md",
    "dist",
    "LICENSE",
    "README.md",
    "skills"
  ],
  "scripts": {
    "build": "rm -rf dist && esbuild src/bin.ts src/preflight.ts src/version.ts --platform=node --format=esm --target=node22 --outdir=dist && esbuild src/main.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/main.cjs && chmod +x dist/bin.js",
    "eval": "npm run build && node evals/run-deterministic.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.0",
    "@ensdomains/ensjs-abi": "^5.0.5",
    "@toon-format/toon": "4.4.0",
    "effect": "4.1.2",
    "fflate": "^0.8.2",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "effect-agent-bind": "0.1.0",
    "effect-epochbox": "0.1.0",
    "esbuild": "0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
